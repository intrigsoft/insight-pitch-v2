{
  "name": "insight-pitch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:reset": "tsx scripts/migrate.mts && tsx scripts/seed.mts",
    "test:e2e": "playwright test",
    "jev:rescore": "tsx --conditions=react-server scripts/jev-rescore.mts",
    "test:visual": "playwright test visual",
